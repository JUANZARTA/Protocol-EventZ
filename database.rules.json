{
  "rules": {
    ".read": false,
    ".write": false,

    "venues": {
      "$venueId": {
        ".read": "auth != null && root.child('venues').child($venueId).child('usuarios').child(auth.uid).exists()",

        "info": {
          ".write": "auth != null && ((!data.exists() && newData.child('duenoUid').val() === auth.uid) || root.child('venues').child($venueId).child('usuarios').child(auth.uid).child('rol').val() === 'administrador')",

          "aprobacionAutomatica": {
            ".read": true
          }
        },

        "usuarios": {
          "$uid": {
            ".write": "auth != null && (((!data.exists()) && (((newData.child('rol').val() === null) && (newData.child('estado').val() === 'pendiente')) || ((newData.child('rol').val() === 'administrador') && (root.child('venues').child($venueId).child('info').child('duenoUid').val() === auth.uid)) || ((newData.child('rol').val() === 'mesero') && (newData.child('estado').val() === 'activo') && (root.child('venues').child($venueId).child('info').child('aprobacionAutomatica').val() === true)))) || (root.child('venues').child($venueId).child('usuarios').child(auth.uid).child('rol').val() === 'administrador'))"
          }
        },

        "eventos": {
          "$eventoId": {
            "info": {
              ".write": "auth != null && (root.child('venues').child($venueId).child('usuarios').child(auth.uid).child('rol').val() === 'administrador' || root.child('venues').child($venueId).child('usuarios').child(auth.uid).child('rol').val() === 'jefe_mesero')"
            },

            "participantes": {
              "$uid": {
                ".write": "auth != null && (auth.uid === $uid || root.child('venues').child($venueId).child('usuarios').child(auth.uid).child('rol').val() === 'administrador' || root.child('venues').child($venueId).child('usuarios').child(auth.uid).child('rol').val() === 'jefe_mesero')"
              }
            },

            "tareas": {
              "$tareaId": {
                ".write": "auth != null && ((root.child('venues').child($venueId).child('usuarios').child(auth.uid).child('rol').val() === 'administrador' || root.child('venues').child($venueId).child('usuarios').child(auth.uid).child('rol').val() === 'jefe_mesero') || (auth.uid === data.child('asignadoA').val() && newData.child('asignadoA').val() === data.child('asignadoA').val() && newData.child('titulo').val() === data.child('titulo').val() && newData.child('tipo').val() === data.child('tipo').val() && newData.child('creadoPor').val() === data.child('creadoPor').val()))"
              }
            },

            "inventario": {
              "$itemId": {
                ".write": "auth != null && (root.child('venues').child($venueId).child('usuarios').child(auth.uid).child('rol').val() === 'administrador' || root.child('venues').child($venueId).child('eventos').child($eventoId).child('info').child('desmontajeAsignadoA').val() === auth.uid)",
                ".validate": "root.child('venues').child($venueId).child('usuarios').child(auth.uid).child('rol').val() === 'administrador' || newData.child('confirmadoPorAdmin').val() === false"
              }
            }
          }
        }
      }
    },

    "codigos_negocio": {
      ".read": true,
      "$codigo": {
        ".write": "auth != null && root.child('venues').child(newData.exists() ? newData.child('venueId').val() : data.child('venueId').val()).child('usuarios').child(auth.uid).child('rol').val() === 'administrador'"
      }
    },

    "usuarios_index": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists()"
      }
    }
  }
}
